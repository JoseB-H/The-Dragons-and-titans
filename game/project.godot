; Engine configuration file.
; Edit with Godot 4.6.3 stable (standard/GDScript edition).

config_version=5

[application]

config/name="Dragons and Titans — Prototipo offline"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

ability_q={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
ability_e={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
restore_arena={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
